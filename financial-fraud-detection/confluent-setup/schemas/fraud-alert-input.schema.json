{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Simplified fraud alert for agent consumption",
  "properties": {
    "alertMessage": {
      "description": "Human-readable fraud alert message",
      "type": "string"
    },
    "cardHash": {
      "description": "Card identifier involved in fraud",
      "type": "string"
    },
    "detectedAt": {
      "description": "When fraud was detected (ISO 8601 timestamp)",
      "type": "string"
    },
    "distanceKm": {
      "description": "Distance between locations in kilometers",
      "minimum": 0,
      "type": "number"
    },
    "firstLocation": {
      "description": "First transaction location (City, Country)",
      "type": "string"
    },
    "firstTransactionId": {
      "description": "First transaction ID for reference",
      "type": "string"
    },
    "secondLocation": {
      "description": "Second transaction location (City, Country)",
      "type": "string"
    },
    "secondTransactionId": {
      "description": "Second transaction ID for reference",
      "type": "string"
    },
    "speedKmh": {
      "description": "Required travel speed in km/h",
      "minimum": 0,
      "type": "number"
    },
    "timeMinutes": {
      "description": "Time between transactions in minutes",
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "cardHash",
    "alertMessage",
    "firstLocation",
    "secondLocation",
    "distanceKm",
    "timeMinutes",
    "speedKmh"
  ],
  "title": "FraudAlertAgent",
  "type": "object"
}