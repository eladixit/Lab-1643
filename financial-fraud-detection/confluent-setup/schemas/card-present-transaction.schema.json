{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Card Present Fraud Transaction",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "accountId": {
      "description": "Bank account or customer account identifier",
      "type": "string"
    },
    "amount": {
      "minimum": 0,
      "type": "number"
    },
    "authResult": {
      "type": "string",
      "enum": ["APPROVED", "DECLINED", "REVERSED", "PENDING"]
    },
    "cardHash": {
      "description": "Tokenized or hashed PAN used to correlate card activity",
      "type": "string"
    },
    "cardPresent": {
      "type": "boolean"
    },
    "channel": {
      "type": "string",
      "enum": ["POS"]
    },
    "currency": {
      "description": "ISO 4217 currency code",
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "eventTime": {
      "description": "Transaction timestamp as milliseconds since epoch (for Flink)",
      "type": "integer",
      "minimum": 0
    },
    "mcc": {
      "description": "Merchant category code",
      "pattern": "^[0-9]{4}$",
      "type": "string"
    },
    "merchantCity": {
      "type": "string"
    },
    "merchantCountry": {
      "description": "ISO 3166-1 alpha-2 country code",
      "pattern": "^[A-Z]{2}$",
      "type": "string"
    },
    "merchantId": {
      "type": "string"
    },
    "merchantLat": {
      "minimum": -90,
      "maximum": 90,
      "type": "number"
    },
    "merchantLon": {
      "minimum": -180,
      "maximum": 180,
      "type": "number"
    },
    "merchantName": {
      "type": "string"
    },
    "merchantState": {
      "type": "string"
    },
    "posEntryMode": {
      "type": "string",
      "enum": ["CHIP", "SWIPE", "CONTACTLESS", "MANUAL", "FALLBACK"]
    },
    "terminalId": {
      "type": "string"
    },
    "transactionId": {
      "description": "Unique transaction identifier",
      "type": "string"
    }
  },
  "required": [
    "transactionId",
    "cardHash",
    "accountId",
    "eventTime",
    "amount",
    "currency",
    "merchantId",
    "merchantCity",
    "merchantCountry",
    "merchantLat",
    "merchantLon",
    "terminalId",
    "posEntryMode",
    "cardPresent",
    "authResult",
    "channel"
  ]
}