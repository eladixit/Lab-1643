{
  "type": "record",
  "name": "FraudAlertAgentResponse",
  "namespace": "com.ibm.fraud.detection",
  "doc": "Fraud alert payload enriched for watsonx Orchestrate agent response with transaction details, confidence assessment, and suggested action",
  "fields": [
    {
      "name": "cardHash",
      "type": "string",
      "doc": "Card identifier involved in the fraud alert"
    },
    {
      "name": "alertMessage",
      "type": "string",
      "doc": "Human-readable fraud alert message"
    },
    {
      "name": "accountId",
      "type": ["null", "string"],
      "default": null,
      "doc": "Account identifier associated with the card when available"
    },
    {
      "name": "detectedAt",
      "type": ["null", "string"],
      "default": null,
      "doc": "When the fraud alert was detected (ISO 8601 date-time)"
    },
    {
      "name": "firstTransaction",
      "doc": "Earlier transaction used in the impossible-travel comparison",
      "type": {
        "type": "record",
        "name": "TransactionSummary",
        "namespace": "com.ibm.fraud.detection",
        "doc": "Condensed transaction details used in impossible-travel comparison",
        "fields": [
          {
            "name": "transactionId",
            "type": "string",
            "doc": "Unique transaction identifier"
          },
          {
            "name": "eventTime",
            "type": "string",
            "doc": "Transaction timestamp in ISO 8601 format"
          },
          {
            "name": "amount",
            "type": "double",
            "doc": "Transaction amount (must be >= 0)"
          },
          {
            "name": "merchantName",
            "type": "string",
            "doc": "Merchant name"
          },
          {
            "name": "merchantCity",
            "type": "string",
            "doc": "Merchant city"
          },
          {
            "name": "merchantCountry",
            "type": "string",
            "doc": "Merchant country code"
          },
          {
            "name": "currency",
            "type": ["null", "string"],
            "default": null,
            "doc": "ISO 4217 currency code"
          },
          {
            "name": "merchantState",
            "type": ["null", "string"],
            "default": null,
            "doc": "Merchant state or region when available"
          },
          {
            "name": "mcc",
            "type": ["null", "string"],
            "default": null,
            "doc": "Merchant category code"
          }
        ]
      }
    },
    {
      "name": "secondTransaction",
      "doc": "Later transaction used in the impossible-travel comparison",
      "type": "com.ibm.fraud.detection.TransactionSummary"
    },
    {
      "name": "travelAnalysis",
      "doc": "Impossible-travel analytics derived from the paired transactions",
      "type": {
        "type": "record",
        "name": "TravelAnalysis",
        "namespace": "com.ibm.fraud.detection",
        "doc": "Impossible-travel analytics derived from paired transactions",
        "fields": [
          {
            "name": "firstLocation",
            "type": "string",
            "doc": "First transaction location formatted as City, Country"
          },
          {
            "name": "secondLocation",
            "type": "string",
            "doc": "Second transaction location formatted as City, Country"
          },
          {
            "name": "distanceKm",
            "type": "double",
            "doc": "Distance between the two transaction locations in kilometers (must be >= 0)"
          },
          {
            "name": "timeMinutes",
            "type": "double",
            "doc": "Elapsed time between the two transactions in minutes (must be >= 0)"
          },
          {
            "name": "speedKmh",
            "type": "double",
            "doc": "Required travel speed between the two transactions in km/h (must be >= 0)"
          }
        ]
      }
    },
    {
      "name": "customerHistorySummary",
      "doc": "Compact customer baseline used by the agent for confidence reasoning",
      "default": null,
      "type": [
        "null",
        {
          "type": "record",
          "name": "CustomerHistorySummary",
          "namespace": "com.ibm.fraud.detection",
          "doc": "Compact customer baseline used by the agent for confidence reasoning",
          "fields": [
            {
              "name": "baselineRegion",
              "type": ["null", "string"],
              "default": null,
              "doc": "Typical city or region observed in recent history"
            },
            {
              "name": "usualCountries",
              "type": ["null", {"type": "array", "items": "string"}],
              "default": null,
              "doc": "Countries commonly seen in recent customer history"
            },
            {
              "name": "typicalMinAmount",
              "type": ["null", "double"],
              "default": null,
              "doc": "Lower bound of typical recent transaction amounts"
            },
            {
              "name": "typicalMaxAmount",
              "type": ["null", "double"],
              "default": null,
              "doc": "Upper bound of typical recent transaction amounts"
            },
            {
              "name": "typicalMerchants",
              "type": ["null", {"type": "array", "items": "string"}],
              "default": null,
              "doc": "Common merchants seen in recent history"
            },
            {
              "name": "historyNote",
              "type": ["null", "string"],
              "default": null,
              "doc": "Short explanation of the customer's normal behavior"
            }
          ]
        }
      ]
    },
    {
      "name": "agentDecision",
      "doc": "Agent response with confidence decision and suggested action",
      "type": {
        "type": "record",
        "name": "AgentDecision",
        "namespace": "com.ibm.fraud.detection",
        "doc": "Agent response with confidence decision and suggested action",
        "fields": [
          {
            "name": "confidenceLevel",
            "type": {
              "type": "enum",
              "name": "ConfidenceLevel",
              "symbols": ["low", "medium", "high"]
            },
            "doc": "Fraud confidence level determined by the agent"
          },
          {
            "name": "reasoning",
            "type": {"type": "array", "items": "string"},
            "doc": "Short reasons supporting the confidence decision (at least 1 item)"
          },
          {
            "name": "suggestedAction",
            "type": {
              "type": "enum",
              "name": "SuggestedAction",
              "symbols": ["monitor", "review", "create_case", "escalate"]
            },
            "doc": "Next best action suggested by the agent"
          },
          {
            "name": "confidenceScore",
            "type": ["null", "int"],
            "default": null,
            "doc": "Optional explainable confidence score from 0 to 100"
          },
          {
            "name": "actionRationale",
            "type": ["null", "string"],
            "default": null,
            "doc": "Why the suggested action was chosen"
          },
          {
            "name": "analystSummary",
            "type": ["null", "string"],
            "default": null,
            "doc": "Concise summary for a fraud analyst or demo output"
          }
        ]
      }
    }
  ]
}
